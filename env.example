# Core
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SET_IN_RENDER_ONLY
FRONTEND_URL=https://flexi-move-lab.lovable.app
FLEXILAB_ALLOWED_ORIGINS=https://flexi-move-lab.lovable.app,https://www.flexilab.fr,https://flexilab.fr
FLEXILAB_APP_VERSION=V100.0

# Analysis and clinical engine
FLEXILAB_POSE_MODEL=yolov8n-pose.pt
FLEXILAB_ANALYSIS_BUCKET=screening-private
FLEXILAB_LIBRARY_MODE=demo
FLEXILAB_INLINE_ANALYSIS=false
ANALYSIS_WORKER_POLL_SECONDS=2
ANALYSIS_WORKER_CLEANUP_SECONDS=300

# Corporate import worker
OPERATOR_WORKER_POLL_SECONDS=2
OPERATOR_IMPORT_BATCH_SIZE=50

# Stripe — use test values until final acceptance testing is complete
STRIPE_SECRET_KEY=SET_IN_RENDER_ONLY
STRIPE_WEBHOOK_SECRET=SET_IN_RENDER_ONLY
STRIPE_PRICE_MONTHLY=price_test_or_live_id
STRIPE_PRICE_THREE_MONTH=price_test_or_live_id
STRIPE_PRICE_ANNUAL=price_test_or_live_id
STRIPE_PRICE_TRAINER_PACK=price_test_or_live_id

# Email status monitoring. Configure transactional delivery in Supabase Auth/SMTP.
RESEND_API_KEY=SET_IN_RENDER_ONLY
SMTP_PASSWORD=SET_IN_RENDER_ONLY
