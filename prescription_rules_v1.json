  "principles": {
    "pain_is_gatekeeper": "Pain does not directly reduce movement score; it creates clinical readiness and modifies the program.",
    "priority_weighting": "Exercise volume is driven by the lowest movement domains, not equal distribution.",
    "cumulative_progression": "High-value corrective drills are maintained until the related domain reaches >=80 twice or reassessment confirms improvement.",
    "replacement_model": "Do not let programs grow indefinitely; keep 5-8 exercises/session by replacing low-value drills when progression is appropriate.",
    "symmetry_rule": "When side-to-side asymmetry is >10%, add extra volume or hold time to the restricted side."
