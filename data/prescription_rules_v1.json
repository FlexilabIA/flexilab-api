{
  "engine_version": "FlexiLab Clinical Prescription Engine v3.0",
  "principles": {
    "user_delegates_complexity": "The user should never need to choose exercises or understand programming complexity.",
    "clinical_targets_stable_exercises_rotate": "Maintain stable clinical targets while rotating coherent exercise variations.",
    "visible_progression": "Week 1 learns, week 2 controls, week 3 loads, week 4 integrates.",
    "engagement_without_randomness": "Variation must preserve biomechanical purpose and never become random.",
    "questionnaire_is_operational": "Pain, goal, activity level, restrictions and available equipment must change prescription decisions.",
    "exercise_specific_dosage": "Exercise metadata controls dosage; generic set overrides are forbidden."
  },
  "week_models": {
    "1": {
      "phase": "Restore & Learn",
      "difficulty_max": 2,
      "load_max": 1,
      "new_exercise_ratio_min": 0.45
    },
    "2": {
      "phase": "Control & Build Capacity",
      "difficulty_max": 3,
      "load_max": 3,
      "new_exercise_ratio_min": 0.4
    },
    "3": {
      "phase": "Strengthen & Stabilize",
      "difficulty_max": 4,
      "load_max": 5,
      "new_exercise_ratio_min": 0.35
    },
    "4": {
      "phase": "Integrate & Challenge",
      "difficulty_max": 5,
      "load_max": 5,
      "new_exercise_ratio_min": 0.3
    }
  },
  "day_models": {
    "1": {
      "focus": "Mobility & Movement Quality",
      "roles": [
        "mobility",
        "activation",
        "stability",
        "recovery"
      ]
    },
    "2": {
      "focus": "Stability & Strength",
      "roles": [
        "activation",
        "stability",
        "integration",
        "mobility"
      ]
    },
    "3": {
      "focus": "Functional Integration",
      "roles": [
        "integration",
        "stability",
        "mobility",
        "activation"
      ]
    }
  },
  "session_rules": {
    "target_exercises": 6,
    "minimum_exercises": 5,
    "maximum_exercises": 7,
    "minimum_difference_between_sessions": 0.45,
    "maximum_recovery_exercises": 1,
    "maximum_same_category": 2,
    "maximum_same_exercise_per_week": 2,
    "maximum_recovery_exposure_per_week": 2,
    "priority_exposure_per_week_min": 4
  },
  "loading_rules": {
    "no_pain": {
      "band_from_week": 2,
      "light_weight_from_week": 3
    },
    "discomfort": {
      "band_from_week": 3,
      "light_weight_from_week": 99
    },
    "pain": {
      "band_from_week": 99,
      "light_weight_from_week": 99
    },
    "beginner": {
      "light_weight_from_week": 4
    },
    "intermediate": {
      "light_weight_from_week": 3
    },
    "advanced": {
      "light_weight_from_week": 2
    }
  },
  "dosage_rules": {
    "recovery_hold": {
      "sets": [
        1,
        1
      ],
      "duration_seconds": [
        30,
        60
      ],
      "max_total_seconds": 75
    },
    "soft_tissue_time": {
      "sets": [
        1,
        1
      ],
      "duration_seconds": [
        30,
        60
      ],
      "max_total_seconds": 60
    },
    "static_hold": {
      "sets": [
        1,
        2
      ],
      "duration_seconds": [
        20,
        45
      ],
      "max_total_seconds": 90
    },
    "dynamic_mobility_reps": {
      "sets": [
        1,
        2
      ],
      "reps": [
        6,
        12
      ]
    },
    "motor_control_reps": {
      "sets": [
        2,
        3
      ],
      "reps": [
        6,
        12
      ]
    },
    "strength_reps": {
      "sets": [
        2,
        3
      ],
      "reps": [
        6,
        15
      ]
    }
  },
  "quality_gates": {
    "reject_identical_sessions": true,
    "reject_week4_not_harder_than_week2": true,
    "reject_generic_timed_hold_multiple_sets": true,
    "reject_missing_loaded_work_when_allowed": true,
    "reject_priority_underexposure": true,
    "reject_recovery_dominance": true
  }
}
